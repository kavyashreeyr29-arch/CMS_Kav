# Copy to .env for local (non-docker) development.
# When running via docker-compose, DATABASE_URL/REDIS_URL are injected automatically —
# keep the other values here in sync regardless.

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# Comma-separated browser origins. Render production should use the Vercel URL.
FRONTEND_URL=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Neon: paste its pooled connection string; keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require
# Use the unpooled Neon URL only for migrations/administration.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-in-every-environment
JWT_EXPIRES_IN=8h

# AI provider keys are NOT set here — they are configured per-org at runtime via the
# Admin "AI integrations" screen (see prd.md §13) and stored encrypted in ai_provider_configs.
AI_ENCRYPTION_KEY=change-me-32-byte-base64-key

# GitHub integration (Admin "GitHub integration" screen) — encrypts the stored
# personal access token at rest. Falls back to AI_ENCRYPTION_KEY if unset, so
# this only needs setting to rotate the GitHub token key independently. The
# per-org webhook secret is generated/stored in the DB, not here.
GITHUB_ENCRYPTION_KEY=change-me-or-reuse-ai-key

# Email-to-ticket (see README.md "Email-to-ticket" for the mailbox-provider
# side of this — this app only exposes the webhook, connecting a real
# mailbox needs SES/SendGrid/Mailgun configuration outside this repo).
EMAIL_INTAKE_SECRET=change-me-shared-webhook-secret
EMAIL_INTAKE_DEFAULT_PROJECT_CODE=ZEN

# S3-compatible object storage (MinIO locally, real S3/R2/etc. in production).
# Must be an address the *browser* can reach — the backend only signs URLs,
# the browser PUTs/GETs the file bytes directly against this host.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=elevatohub
S3_SECRET_KEY=elevatohub123
S3_BUCKET=elevatohub-attachments
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Neon Object Storage (provided by `neon env pull` / Render env settings).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=aws-ap-southeast-1
