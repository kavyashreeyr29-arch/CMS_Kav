# Copy to .env for local (non-docker) development.
# When running via docker-compose, DATABASE_URL/REDIS_URL are injected automatically —
# keep the other values here in sync regardless.

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://elevatohub:elevatohub@localhost:5432/elevatohub?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-in-every-environment
JWT_EXPIRES_IN=8h

# AI provider keys are NOT set here — they are configured per-org at runtime via the
# Admin "AI integrations" screen (see prd.md §13) and stored encrypted in ai_provider_configs.
AI_ENCRYPTION_KEY=change-me-32-byte-base64-key

# Email-to-ticket (see README.md "Email-to-ticket" for the mailbox-provider
# side of this — this app only exposes the webhook, connecting a real
# mailbox needs SES/SendGrid/Mailgun configuration outside this repo).
EMAIL_INTAKE_SECRET=change-me-shared-webhook-secret
EMAIL_INTAKE_DEFAULT_PROJECT_CODE=ZEN

# S3-compatible object storage (MinIO locally, real S3/R2/etc. in production).
# Must be an address the *browser* can reach — the backend only signs URLs,
# the browser PUTs/GETs the file bytes directly against this host.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=elevatohub
S3_SECRET_KEY=elevatohub123
S3_BUCKET=elevatohub-attachments
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
